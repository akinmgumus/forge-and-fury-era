ZVSE2

** TUM CREATURE ABILITIES (WoG option 950 "Creature Tweaks")
** GENERATED by src/make_tum_abilities.py - do not edit by hand.
**
** - Third upgrades (Third Upgrade Mod in ResOunD) get stack experience abilities of their
**   lower upgrade that they were missing (e.g. Winged Magog: No Range Penalty).
** - Hatreds: a creature hates every member of an upgrade chain if it, or a creature it is
**   upgraded from, hates any member of it (e.g. Fairy also hates Skeleton Knights).
**   Native hatreds are in the cfg files of "Data/Creatures" (always active).
** - Pit Master summons Sharp-Horned Demons, Spellweaver clones itself.
** Rows go to free stack experience slots, existing abilities are kept.

!#DC(TUMA_OPTION) = 950;

; Finds the slot of a stack experience row (-1 if the creature does not have it).
; EA:F returns an empty line when the row is not found, so the line is checked.
!?FU(TUMA_FindRow);
!#VA(mon:x) (ability:x) (modifier:x) (result:x);

!!VR(result):S-1;
!!EA(mon):F(ability)/(modifier)/?(slot:y);
!!FU|(slot)<0/(slot)>19:E;
!!EA(mon):B(slot)/?(active:y)/?(foundAbility:y)/?(foundModifier:y)/d/d/d/d/d/d/d/d/d/d/d;
!!VR(result)&(foundAbility)=(ability)/(foundModifier)=(modifier):S(slot);

; Adds a stack experience row to a free slot (6-19), unless the creature already has it.
!?FU(TUMA_AddRow);
!#VA(mon:x) (ability:x) (modifier:x) (r0:x) (r1:x) (r2:x) (r3:x) (r4:x) (r5:x) (r6:x) (r7:x) (r8:x) (r9:x) (r10:x);

!!FU(TUMA_FindRow):P(mon)/(ability)/(modifier)/?(existing:y);
!!FU&(existing)>=0:E;

!!VR(slot:y):S-1;
!!re k/6/19;
  !!EA(mon):Bk/?(active:y)/?(oldAbility:y)/d/d/d/d/d/d/d/d/d/d/d/d;
  !!if|(active)=0/(oldAbility)=0;
    !!VR(slot):Sk;
    !!br;
  !!en;
!!en;

!!EA(mon)&(slot)>=0:B(slot)/1/(ability)/(modifier)/(r0)/(r1)/(r2)/(r3)/(r4)/(r5)/(r6)/(r7)/(r8)/(r9)/(r10);

; Changes the modifier of an existing stack experience row
!?FU(TUMA_ChangeModifier);
!#VA(mon:x) (ability:x) (oldModifier:x) (newModifier:x);

!!FU(TUMA_FindRow):P(mon)/(ability)/(oldModifier)/?(slot:y);
!!EA(mon)&(slot)>=0:B(slot)/d/d/(newModifier)/d/d/d/d/d/d/d/d/d/d/d;

; Disables a stack experience row
!?FU(TUMA_DisableRow);
!#VA(mon:x) (ability:x) (modifier:x);

!!FU(TUMA_FindRow):P(mon)/(ability)/(modifier)/?(slot:y);
!!EA(mon)&(slot)>=0:B(slot)/0/d/d/d/d/d/d/d/d/d/d/d/d/d;

; Appends "Hates <names>." to the description of a creature. Targets end with -1.
!?FU(TUMA_AddHateText);
!#VA(mon:x);

!!VR(names:z):S^^;
!!re i/2/16;
  !!br&xi<0;
  !!SN:H^monname^/xi/1/?(name:z);
  !!VR(names)&i>2:+^, ^;
  !!VR(names):+(name);
!!en;

!!SN:H^monname^/(mon)/2/?(desc:z);
!!SN:H^monname^/(mon)/2/^%(desc) Hates %(names).^;

; Native hatreds from the cfg files are always active, so their texts are too.
!?FU(OnAfterErmInited)&i^cr_hasResound^;
